# TICKR backend — copy to `.env` and fill in the secrets.
# Every value below is read by packages/backend/src/config.ts.
# Configure up to eight fallback RPCs for the selected chain.

# --- server ---------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:3000,https://tickrbase.top

# --- chain ----------------------------------------------------------------
# testnet | mainnet
TICKR_CHAIN_ENV=testnet
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
BASE_MAINNET_RPC_URL=https://mainnet.base.org
# Optional failover RPCs. Use endpoints for the same chain as TICKR_CHAIN_ENV.
FALLBACK_RPC_URL=
FALLBACK_RPC_URL_2=
FALLBACK_RPC_URL_3=
FALLBACK_RPC_URL_4=
FALLBACK_RPC_URL_5=
FALLBACK_RPC_URL_6=
FALLBACK_RPC_URL_7=
FALLBACK_RPC_URL_8=

# --- backend signer (REQUIRED) ----------------------------------------------
# Private key of the wallet authorized as PriceOracle backendSigner
# (set at deploy time via Deploy.ts). 0x-prefixed, never commit this file.
BACKEND_SIGNER_PRIVATE_KEY=

# --- season -----------------------------------------------------------------
SEASON_ID=2

# --- contract addresses (defaults = current Base Sepolia deployment) --------
TICK_TOKEN_ADDRESS=0xD7DAd21d5e61f398c88dA6d15b5CD03f6bBc499b
PLAYER_STATS_ADDRESS=0x6d48c38c2036b3d31328b48bd8b72785ab2d15a9
PRICE_ORACLE_ADDRESS=0x2814bd64f7774eccd5dc11a792f15fecdfebdf90
SEASON_REGISTRY_ADDRESS=0xe6f2c8a55a3f4f34a7abd833afece63d9789c260
TEAM_REGISTRY_S1_ADDRESS=0x352e6fce9c07de4bf3e187ce93a0120db05d2ea8
MATCH_REGISTRY_S1_ADDRESS=0xd5b0d27bb9c523ed777f355191a9dd2dcbee0c62
PREDICTION_POOL_ADDRESS=0xc47358e69d145f94728796a337ec14401641700f
RESULT_ENGINE_ADDRESS=0x82e00f543ddf320eec4447fd16810852bda4ec12

MARKET_FACTORY_ADDRESS=0x915c36ffb6fe3cd65780fcafa2b489ce6eafdca1
MARKET_FACTORY_DEPLOY_BLOCK=47568821
MARKET_FACTORY_DEPLOY_BLOCK=47456889


# --- binance (backend price heartbeat) --------------------------------------
# The 24/7 Binance WebSocket stream is OFF by default in the optimized
# backend (it burned ~8-13 GB/month alone). The backend now polls REST on a
# heartbeat (60s idle, 15s in hot windows); live streaming moved to the
# frontend clients. These vars remain for the heartbeat + gap-fill.
BINANCE_WS_PRIMARY_HOST=wss://data-stream.binance.vision
BINANCE_WS_FALLBACK_HOST=wss://stream.binance.com:9443
BINANCE_REST_BASE_URL=https://data-api.binance.vision
# REST heartbeat poll cadence (ms) while idle. Hot-window cadence is 15s.
BINANCE_REST_POLL_MS=60000

# --- coingecko (fallback prices + token metadata) ----------------------------
# Demo API key (free). Leave empty to use the keyless tier (lower rate limit).
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- league ------------------------------------------------------------------
# Match duration is backend-side only — the contracts never enforce it.
MAIN_LEAGUE_MATCH_DURATION_MINUTES=60
# Kickoff reveal fallback lead (minutes) used only when a scheduled slot was
# missed (backend downtime). Clamped into the contract's 30–120 bounds.
KICKOFF_LEAD_MINUTES=60

# --- oracle checkpoints -------------------------------------------------------
CHECKPOINT_INTERVAL_MINUTES=60
CHECKPOINT_BATCH_SIZE=20

# --- factory keeper ------------------------------------------------------------
FACTORY_KEEPER_ENABLED=true
FACTORY_KEEPER_INTERVAL_MINUTES=15
FACTORY_KEEPER_MAX_PER_PASS=10

# --- price validation ---------------------------------------------------------
# Max |binance − coingecko| / coingecko deviation, in basis points (200 = 2%).
PRICE_DEVIATION_MAX_BPS=200

# --- leaderboard event scan ----------------------------------------------------
# First block scanned for PlayerStats.OutcomeRecorded events.
# Base Sepolia's public RPC caps eth_getLogs at 1,000 blocks per call, so the
# backend pages through history in chunks starting here. Set to the
# PlayerStats deployment block to skip empty history. 0 = genesis.
LEADERBOARD_SCAN_START_BLOCK=47283463

# --- social indexer (Supabase) ---------------------------------------------------
# Leave empty to disable the social layer (indexer no-ops, /api/social/* 503s).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# First block scanned for MarketFactory events. Leave empty to backfill the
# last 200k blocks on first boot.
MARKET_FACTORY_DEPLOY_BLOCK=
