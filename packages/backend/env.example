# TICKR backend — copy to `.env` and fill in the secrets.
# Every value below is read by packages/backend/src/config.ts.

# --- server ---------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- chain ----------------------------------------------------------------
# testnet | mainnet
TICKR_CHAIN_ENV=testnet
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# --- backend signer (REQUIRED) ----------------------------------------------
# Private key of the wallet authorized as PriceOracle backendSigner
# (set at deploy time via Deploy.ts). 0x-prefixed, never commit this file.
BACKEND_SIGNER_PRIVATE_KEY=

# --- season -----------------------------------------------------------------
SEASON_ID=1

# --- contract addresses (defaults = current Base Sepolia deployment) --------
TICK_TOKEN_ADDRESS=0x9284ae11bFA0616177462D149fF3C6E803053FED
PLAYER_STATS_ADDRESS=0x7bEE9463A80Db25528548981a6FecfEC4942E789
PRICE_ORACLE_ADDRESS=0xC439Fc957041990E3CEBC7e327d4a135450A5DB6
SEASON_REGISTRY_ADDRESS=0x9150456181e1EcAD4989e6A4aEAFaD6af184f0B6
TEAM_REGISTRY_S1_ADDRESS=0x5090FD25f46791a217153C3b10Cc0d850CEbA756
MATCH_REGISTRY_S1_ADDRESS=0x08F2929F2BA4a60c2b5485b4CC2c1881dE7C903c
PREDICTION_POOL_ADDRESS=0x008d64439DD189480EDc9b74983db6D87fD8F48A
RESULT_ENGINE_ADDRESS=0xA02Be4BDb0FF7E774FA3CFAa8D879bDbd06AF5D6

# --- binance (primary price feed) -------------------------------------------
BINANCE_WS_PRIMARY_HOST=wss://data-stream.binance.vision
BINANCE_WS_FALLBACK_HOST=wss://stream.binance.com:9443
BINANCE_REST_BASE_URL=https://data-api.binance.vision
# REST poll cadence (ms) while the WebSocket is down.
BINANCE_REST_POLL_MS=10000

# --- coingecko (fallback prices + token metadata) ----------------------------
# Demo API key (free). Leave empty to use the keyless tier (lower rate limit).
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# --- league ------------------------------------------------------------------
# Match duration is backend-side only — the contracts never enforce it.
MAIN_LEAGUE_MATCH_DURATION_MINUTES=20
# Kickoff reveal lead time (minutes). Must stay within 30–120 (contract bounds).
KICKOFF_LEAD_MINUTES=60

# --- price validation ---------------------------------------------------------
# Max |binance − coingecko| / coingecko deviation, in basis points (200 = 2%).
PRICE_DEVIATION_MAX_BPS=200

# --- leaderboard event scan ----------------------------------------------------
# First block scanned for PlayerStats.OutcomeRecorded events.
# Base Sepolia's public RPC caps eth_getLogs at 1,000 blocks per call, so the
# backend pages through history in chunks starting here. Set to the
# PlayerStats deployment block to skip empty history. 0 = genesis.
LEADERBOARD_SCAN_START_BLOCK=47283463
