pragma solidity ^0.8.28;

import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
import { CupConstants } from "./CupConstants.sol";

/// @title CupRegistry — CRYPTO PRICE WORLD CUP bracket, draw & kickoffs
///
/// @notice Brand-new cup contract. NOTHING in the league's contracts is
/// touched: no shared storage, no shared wiring, no cross-calls into
/// MatchRegistry / ResultEngine / PriceOracle / PredictionPool.
///
/// This registry owns the 64-team single-elimination bracket: team
/// registration, the two-phase future-blockhash draw, kickoff reveal
/// gating, and winner advancement. Scoring and settlement live in
/// CupEngine; pools live in CupPool; manipulation adjudication lives in
/// DisputeBallot.
///
/// Bracket indexing: R64 = matches 0–31, R32 = 32–47, R16 = 48–55,
/// QF = 56–59, SF = 60–61, Final = 62. Each later-round match stores its
/// two feeder match ids; the engine's recordResult writes the winner into
/// the next slot, so every team knows its full path from the draw.
contract CupRegistry is Ownable {
    uint64 public constant MATCH_DURATION = 1 hours;
    uint64 public constant MIN_KICKOFF_LEAD = 1 hours;
    uint256 public constant DRAW_DELAY_BLOCKS = 100;
    uint256 public constant DRAW_EXECUTION_WINDOW = 256; // blockhash availability

    enum MatchState {
        Created, // draw done, no kickoff yet
        Open, // kickoff revealed
        Settled, // winner decided and advanced
        Disputed // engine paused it; ballot open or awaiting verdict

    }

    struct Team {
        string symbol;
        uint8 pot; // 1..4
    }

    /// @notice Kept lean on purpose: read via getMatch(), never the
    /// autogenerated mapping getter (isolated-IR stack-too-deep lesson).
    struct CupMatch {
        uint16 teamA;
        uint16 teamB;
        uint16 feederA; // CupConstants.TBD for R64
        uint16 feederB; // CupConstants.TBD for R64
        uint16 winner; // CupConstants.TBD until settled
        uint64 kickoffTimestamp;
        uint64 endTimestamp;
        MatchState state;
        int16 goalsA;
        int16 goalsB;
    }

    address public engine;
    bool public engineSet;
    address public operator;

    mapping(uint16 => Team) private _teams;
    bool public teamsRegistered;

    mapping(uint16 => CupMatch) private _matches;
    mapping(uint16 => uint16) public childOf; // feeder match id => next-round match id

    bool public drawRequested;
    bool public drawExecuted;
    uint256 public drawBlock;

    event OperatorUpdated(address indexed newOperator);
    event EngineSet(address indexed engine);
    event TeamsRegistered();
    event DrawRequested(uint256 indexed drawBlock);
    event DrawExecuted(uint256 indexed seedBlock, bytes32 seed);
    event KickoffRevealed(uint16 indexed matchId, uint64 kickoffTimestamp);
    event MatchSettled(uint16 indexed matchId, uint16 indexed winner, int16 goalsA, int16 goalsB);
    event WinnerAdvanced(uint16 indexed fromMatchId, uint16 indexed toMatchId, uint16 indexed winner);
    event MatchDisputed(uint16 indexed matchId);

    error OnlyOperator();
    error OnlyEngine();
    error EngineAlreadySet();
    error TeamsAlreadyRegistered();
    error InvalidTeamData();
    error DrawAlreadyRequested();
    error DrawNotRequested();
    error DrawAlreadyExecuted();
    error DrawBlockNotReached(uint256 currentBlock, uint256 drawBlock);
    error DrawBlockExpired(uint256 currentBlock, uint256 drawBlock);
    error InvalidMatchId(uint16 matchId);
    error InvalidState(uint16 matchId, MatchState state);
    error KickoffTooSoon(uint64 kickoffTimestamp, uint64 earliestAllowed);
    error FeederNotSettled(uint16 feederMatchId);
    error TeamNotInMatch(uint16 matchId, uint16 teamId);

    modifier onlyOperator() {
        if (msg.sender != operator) revert OnlyOperator();
        _;
    }

    modifier onlyEngine() {
        if (msg.sender != engine) revert OnlyEngine();
        _;
    }

    constructor(address initialOwner, address _operator) Ownable(initialOwner) {
        operator = _operator;
    }

    /// @notice One-time wiring to the cup's own engine. Never the league's.
    function setEngine(address _engine) external onlyOwner {
        if (engineSet) revert EngineAlreadySet();
        engine = _engine;
        engineSet = true;
        emit EngineSet(_engine);
    }

    function setOperator(address _operator) external onlyOwner {
        operator = _operator;
        emit OperatorUpdated(_operator);
    }

    // ---------------------------------------------------------------------
    // Teams
    // ---------------------------------------------------------------------

    /// @notice One-time registration of the 64 teams, pre-draw. pots[i] must
    /// be 1..4 and each pot must hold exactly 16 teams (giants-vs-underdogs
    /// draw invariant).
    function registerTeams(string[] calldata symbols, uint8[] calldata pots) external onlyOwner {
        if (teamsRegistered) revert TeamsAlreadyRegistered();
        if (symbols.length != CupConstants.TEAM_COUNT || pots.length != CupConstants.TEAM_COUNT) revert InvalidTeamData();

        uint256[5] memory potCounts;
        for (uint16 i = 0; i < CupConstants.TEAM_COUNT; i++) {
            if (pots[i] < 1 || pots[i] > 4) revert InvalidTeamData();
            potCounts[pots[i]] += 1;
            _teams[i] = Team({ symbol: symbols[i], pot: pots[i] });
        }
        for (uint8 p = 1; p <= 4; p++) {
            if (potCounts[p] != 16) revert InvalidTeamData();
        }

        teamsRegistered = true;
        emit TeamsRegistered();
    }

    function getTeam(uint16 teamId) external view returns (Team memory) {
        if (teamId >= CupConstants.TEAM_COUNT) revert InvalidTeamData();
        return _teams[teamId];
    }

    // ---------------------------------------------------------------------
    // Draw — two-phase future-blockhash, permissionless execution
    // ---------------------------------------------------------------------

    /// @notice Phase 1 (owner): commits to a future block whose hash does not
    /// exist yet, so the draw seed cannot be known or rigged at request time.
    /// Re-requestable if a previous request expired unexecuted.
    function requestDraw() external onlyOwner {
        if (!teamsRegistered) revert InvalidTeamData();
        if (drawExecuted) revert DrawAlreadyExecuted();
        if (drawRequested && block.number <= drawBlock + DRAW_EXECUTION_WINDOW) {
            revert DrawAlreadyRequested();
        }
        drawRequested = true;
        drawBlock = block.number + DRAW_DELAY_BLOCKS;
        emit DrawRequested(drawBlock);
    }

    /// @notice Phase 2 (permissionless): anyone executes once drawBlock is
    /// mined, while its hash is still available (256-block window).
    function executeDraw() external {
        if (!drawRequested) revert DrawNotRequested();
        if (drawExecuted) revert DrawAlreadyExecuted();
        if (block.number <= drawBlock) revert DrawBlockNotReached(block.number, drawBlock);
        if (block.number > drawBlock + DRAW_EXECUTION_WINDOW) {
            revert DrawBlockExpired(block.number, drawBlock);
        }

        bytes32 seedHash = blockhash(drawBlock);
        if (seedHash == bytes32(0)) revert DrawBlockExpired(block.number, drawBlock);

        drawExecuted = true;
        _runDraw(uint256(seedHash));
        emit DrawExecuted(drawBlock, seedHash);
    }

    function _runDraw(uint256 seed) private {
        // Upper half (pots 1+2) vs lower half (pots 3+4): giants vs underdogs.
        uint16[] memory upper = new uint16[](32);
        uint16[] memory lower = new uint16[](32);
        uint256 ui;
        uint256 li;
        for (uint16 t = 0; t < CupConstants.TEAM_COUNT; t++) {
            uint8 pot = _teams[t].pot;
            if (pot <= 2) {
                upper[ui++] = t;
            } else {
                lower[li++] = t;
            }
        }

        uint256 nonce;
        _fisherYates(upper, seed, nonce);
        nonce += upper.length;
        _fisherYates(lower, seed, nonce);

        // R64: matches 0–31.
        for (uint16 i = 0; i < 32; i++) {
            _matches[i] = CupMatch({
                teamA: upper[i],
                teamB: lower[i],
                feederA: CupConstants.TBD,
                feederB: CupConstants.TBD,
                winner: CupConstants.TBD,
                kickoffTimestamp: 0,
                endTimestamp: 0,
                state: MatchState.Created,
                goalsA: 0,
                goalsB: 0
            });
        }

        // Later rounds: feeders fixed, teams CupConstants.TBD until winners advance.
        _buildRound(CupConstants.R32_START, 16, 0); // 32–47  <- R64 pairs
        _buildRound(CupConstants.R16_START, 8, CupConstants.R32_START); // 48–55  <- R32 pairs
        _buildRound(CupConstants.QF_START, 4, CupConstants.R16_START); // 56–59  <- R16 pairs
        _buildRound(CupConstants.SF_START, 2, CupConstants.QF_START); // 60–61  <- QF pairs
        _buildRound(CupConstants.FINAL_MATCH_ID, 1, CupConstants.SF_START); // 62      <- SF pair
    }

    function _buildRound(uint16 startId, uint16 count, uint16 feederStart) private {
        for (uint16 i = 0; i < count; i++) {
            uint16 matchId = startId + i;
            uint16 feederA = feederStart + 2 * i;
            uint16 feederB = feederStart + 2 * i + 1;
            _matches[matchId] = CupMatch({
                teamA: CupConstants.TBD,
                teamB: CupConstants.TBD,
                feederA: feederA,
                feederB: feederB,
                winner: CupConstants.TBD,
                kickoffTimestamp: 0,
                endTimestamp: 0,
                state: MatchState.Created,
                goalsA: 0,
                goalsB: 0
            });
            childOf[feederA] = matchId;
            childOf[feederB] = matchId;
        }
    }

    function _fisherYates(uint16[] memory arr, uint256 seed, uint256 nonce) private pure {
        for (uint256 i = arr.length; i > 1; i--) {
            uint256 j = uint256(keccak256(abi.encode(seed, nonce + i))) % i;
            (arr[i - 1], arr[j]) = (arr[j], arr[i - 1]);
        }
    }

    // ---------------------------------------------------------------------
    // Kickoff reveal (per-match gating: both feeders must have settled)
    // ---------------------------------------------------------------------

    function revealKickoff(uint16 matchId, uint64 kickoffTimestamp) external onlyOperator {
        if (matchId >= CupConstants.MATCH_COUNT) revert InvalidMatchId(matchId);
        CupMatch storage m = _matches[matchId];
        if (m.state != MatchState.Created) revert InvalidState(matchId, m.state);

        uint64 earliest = uint64(block.timestamp) + MIN_KICKOFF_LEAD;
        if (kickoffTimestamp < earliest) revert KickoffTooSoon(kickoffTimestamp, earliest);

        if (m.feederA != CupConstants.TBD) {
            if (_matches[m.feederA].state != MatchState.Settled) revert FeederNotSettled(m.feederA);
            if (_matches[m.feederB].state != MatchState.Settled) revert FeederNotSettled(m.feederB);
        }

        m.kickoffTimestamp = kickoffTimestamp;
        m.endTimestamp = kickoffTimestamp + MATCH_DURATION;
        m.state = MatchState.Open;
        emit KickoffRevealed(matchId, kickoffTimestamp);
    }

    // ---------------------------------------------------------------------
    // Engine callbacks
    // ---------------------------------------------------------------------

    /// @notice Records a decided match and advances the winner into the next
    /// round's slot. Only the cup's own engine can call this.
    function recordResult(uint16 matchId, uint16 winner, int16 goalsA, int16 goalsB) external onlyEngine {
        if (matchId >= CupConstants.MATCH_COUNT) revert InvalidMatchId(matchId);
        CupMatch storage m = _matches[matchId];
        if (m.state != MatchState.Open && m.state != MatchState.Disputed) {
            revert InvalidState(matchId, m.state);
        }
        if (winner != m.teamA && winner != m.teamB) revert TeamNotInMatch(matchId, winner);

        m.winner = winner;
        m.goalsA = goalsA;
        m.goalsB = goalsB;
        m.state = MatchState.Settled;

        // childOf[final] was never written (0); every real child id is >= 32,
        // so 0 unambiguously means "no child".
        uint16 child = childOf[matchId];
        if (child != 0) {
            CupMatch storage c = _matches[child];
            if (c.feederA == matchId) {
                c.teamA = winner;
            } else {
                c.teamB = winner;
            }
            emit WinnerAdvanced(matchId, child, winner);
        }

        emit MatchSettled(matchId, winner, goalsA, goalsB);
    }

    /// @notice Pauses a match whose scoreline tripped the engine's circuit
    /// breaker. Only the cup's own engine can call this.
    function markDisputed(uint16 matchId) external onlyEngine {
        if (matchId >= CupConstants.MATCH_COUNT) revert InvalidMatchId(matchId);
        CupMatch storage m = _matches[matchId];
        if (m.state != MatchState.Open) revert InvalidState(matchId, m.state);
        m.state = MatchState.Disputed;
        emit MatchDisputed(matchId);
    }

    // ---------------------------------------------------------------------
    // Views (explicit getters — no wide autogenerated mapping getters)
    // ---------------------------------------------------------------------

    function getMatch(uint16 matchId) external view returns (CupMatch memory) {
        if (matchId >= CupConstants.MATCH_COUNT) revert InvalidMatchId(matchId);
        return _matches[matchId];
    }

    /// @notice 0=R64, 1=R32, 2=R16, 3=QF, 4=SF, 5=Final.
    function roundOf(uint16 matchId) public pure returns (uint8) {
        if (matchId >= CupConstants.MATCH_COUNT) revert InvalidMatchId(matchId);
        if (matchId < CupConstants.R32_START) return 0;
        if (matchId < CupConstants.R16_START) return 1;
        if (matchId < CupConstants.QF_START) return 2;
        if (matchId < CupConstants.SF_START) return 3;
        if (matchId < CupConstants.FINAL_MATCH_ID) return 4;
        return 5;
    }

    function tournamentComplete() public view returns (bool) {
        return _matches[CupConstants.FINAL_MATCH_ID].state == MatchState.Settled;
    }

    function champion() external view returns (uint16) {
        if (!tournamentComplete()) revert InvalidState(CupConstants.FINAL_MATCH_ID, _matches[CupConstants.FINAL_MATCH_ID].state);
        return _matches[CupConstants.FINAL_MATCH_ID].winner;
    }
}
