NEXT_PUBLIC_TICK_TOKEN_ADDRESS=0xD7DAd21d5e61f398c88dA6d15b5CD03f6bBc499b
NEXT_PUBLIC_PLAYER_STATS_ADDRESS=0x6c6A1e8AA000527FdA6DEC9Ef3b9Cf77C37C650E
