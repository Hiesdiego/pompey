# ── TICKR frontend env ─────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.

# Privy (auth + embedded wallets) — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=cmugwksgq00up0cl3t3b15x6c
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Backend API base URL
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000

# Chain: testnet (Base Sepolia) | mainnet (Base)
NEXT_PUBLIC_TICKR_CHAIN_ENV=testnet
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=

# ── Deployed contracts (Base Sepolia, Season 1) ──
# Fill in after each TickrV01Module deploy. Empty = not wired up yet.
NEXT_PUBLIC_SEASON_ID=1
NEXT_PUBLIC_TICK_TOKEN_ADDRESS=0x9284ae11bFA0616177462D149fF3C6E803053FED
NEXT_PUBLIC_PLAYER_STATS_ADDRESS=0x7bEE9463A80Db25528548981a6FecfEC4942E789
NEXT_PUBLIC_PRICE_ORACLE_ADDRESS=0xC439Fc957041990E3CEBC7e327d4a135450A5DB6
NEXT_PUBLIC_SEASON_REGISTRY_ADDRESS=0x9150456181e1EcAD4989e6A4aEAFaD6af184f0B6
NEXT_PUBLIC_TEAM_REGISTRY_S1_ADDRESS=0x5090FD25f46791a217153C3b10Cc0d850CEbA756
