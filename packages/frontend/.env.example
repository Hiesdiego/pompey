# ── TICKR frontend env ─────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.

# Privy (auth + embedded wallets) — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=cmugwksgq00up0cl3t3b15x6c
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Backend API base URL
# Server-only. The browser reaches it through the same-origin /backend-api proxy.
BACKEND_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://tickrbase.top

# Chain: testnet (Base Sepolia) | mainnet (Base)
NEXT_PUBLIC_TICKR_CHAIN_ENV=testnet
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=
# Optional comma-separated, browser-visible read RPCs. The five public Base
# Sepolia fallback endpoints are already included in usePublicClient.ts.
# Never put private or keyed RPC URLs here.
NEXT_PUBLIC_BASE_SEPOLIA_FALLBACK_RPC_URLS=
NEXT_PUBLIC_BASE_MAINNET_FALLBACK_RPC_URLS=

# ── Deployed contracts (Base Sepolia, Season 1) ──
# Fill in after each TickrV01Module deploy. Empty = not wired up yet.
NEXT_PUBLIC_SEASON_ID=2
NEXT_PUBLIC_TICK_TOKEN_ADDRESS=0xD7DAd21d5e61f398c88dA6d15b5CD03f6bBc499b
NEXT_PUBLIC_PLAYER_STATS_ADDRESS=0x6d48c38c2036b3d31328b48bd8b72785ab2d15a9
NEXT_PUBLIC_PRICE_ORACLE_ADDRESS=0x2814bd64f7774eccd5dc11a792f15fecdfebdf90
NEXT_PUBLIC_SEASON_REGISTRY_ADDRESS=0xe6f2c8a55a3f4f34a7abd833afece63d9789c260
NEXT_PUBLIC_TEAM_REGISTRY_S1_ADDRESS=0x352e6fce9c07de4bf3e187ce93a0120db05d2ea8
NEXT_PUBLIC_MATCH_REGISTRY_S1_ADDRESS=0xd5b0d27bb9c523ed777f355191a9dd2dcbee0c62
NEXT_PUBLIC_PREDICTION_POOL_ADDRESS=0xc47358e69d145f94728796a337ec14401641700f
NEXT_PUBLIC_RESULT_ENGINE_ADDRESS=0x82e00f543ddf320eec4447fd16810852bda4ec12
# v0.2: MarketFactory — fill in after the v0.2 redeploy. Empty = markets tab shows "not deployed yet".
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=0x915c36ffb6fe3cd65780fcafa2b489ce6eafdca1

# Social layer — server-side only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PRIVY_APP_ID may reuse NEXT_PUBLIC_PRIVY_APP_ID; the secret is server-only.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
