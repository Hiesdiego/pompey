NEXT_PUBLIC_CUP_MATCH_POOL_ADDRESS=0x871d9d44296f1bd09db0c096e69a130c33d7bc48

# Social layer — server-side only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PRIVY_APP_ID may reuse NEXT_PUBLIC_PRIVY_APP_ID; the secret is server-only.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
